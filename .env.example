# ============================================================================
#  Credenciales del dialer.  Copiar a /root/.env_dialer  y hacer chmod 600.
#  NUNCA subir este archivo con valores reales al control de versiones.
# ============================================================================

# ── CRM (GoHighLevel u otro) ────────────────────────────────────────────────
# Los nombres llevan el prefijo GHL_ porque el kit nacio integrado a GoHighLevel.
# El codigo acepta tambien el prefijo CRM_ si preferis nombres neutrales: se usa
# el que este definido.
#
# Token de API con permisos de contactos, notas, etiquetas y usuarios.
GHL_API_TOKEN=<TU_TOKEN_DEL_CRM>
# Identificador de la cuenta o subcuenta dentro del CRM.
GHL_LOCATION_ID=<TU_LOCATION_ID>
# Token de solo lectura, si tu CRM separa permisos. Si no, repeti el de arriba.
GHL_READ_TOKEN=<TU_TOKEN_DE_LECTURA>
# Clave de la API de etiquetas, si tu CRM la tiene aparte. Opcional.
GHL_TAGS_API_KEY=<TU_API_KEY_DE_ETIQUETAS>

# ── Token que el CRM usa para llamar al dialer ──────────────────────────────
# Se genera en el dialer y se pone en el header Authorization de los webhooks.
# Es lo único que impide que un tercero te inyecte leads falsos.
DIALER_API_TOKEN=<TOKEN_QUE_GENERES_EN_EL_DIALER>

# ── Transcripción con IA (opcional) ─────────────────────────────────────────
# Si se deja vacío, no se transcribe nada y el resto sigue funcionando.
OPENAI_API_KEY=<TU_API_KEY>

# ── Proveedor SIP (opcional; solo para consultar saldo y uso) ───────────────
TELNYX_API_KEY=<TU_API_KEY>

# ── Base de datos externa para reportes (opcional) ──────────────────────────
SUPABASE_URL=<https://tu-proyecto.supabase.co>
SUPABASE_SERVICE_KEY=<TU_SERVICE_KEY>

# ── Base de datos y almacenamiento de OMniLeads ─────────────────────────────
# Los scripts que corren FUERA de Django (transcripción, reportes) necesitan
# entrar directo a la base y al almacenamiento de grabaciones.
# OMniLeads trae valores de fábrica: cambialos en tu instalación y ponelos acá.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=omnileads
DB_USER=omnileads
DB_PASSWORD=<CLAVE_DE_POSTGRES>

STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=<USUARIO_DEL_ALMACENAMIENTO>
STORAGE_SECRET_KEY=<CLAVE_DEL_ALMACENAMIENTO>

# ── Zona horaria ────────────────────────────────────────────────────────────
# Debe coincidir con la del servidor donde corre la central telefónica.
# Si no coincide, la transcripción busca las grabaciones en la carpeta del
# día equivocado y no encuentra nada.
DIALER_TZ=America/New_York

# ── Interruptor de lanzamiento ──────────────────────────────────────────────
# En 0 los webhooks responden OK pero NO inyectan leads. Sirve para dejar todo
# conectado y probado antes de abrir la llave. Poner en 1 el día del arranque.
DIALER_LIVE=0
