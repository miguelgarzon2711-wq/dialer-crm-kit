# ============================================================================
#  Dialer credentials.  Copy to /root/.env_dialer  and chmod 600.
#  NEVER commit this file with real values.
# ============================================================================

# -- CRM (GoHighLevel or another) --------------------------------------------
# Names carry the GHL_ prefix because the kit was born integrated with
# GoHighLevel. The code also accepts the CRM_ prefix if you prefer neutral
# names: whichever is defined gets used.
#
# API token with permissions for contacts, notes, tags and users.
GHL_API_TOKEN=<YOUR_CRM_TOKEN>
# Identifier of the account or sub-account inside the CRM.
GHL_LOCATION_ID=<YOUR_LOCATION_ID>
# Read-only token, if your CRM separates permissions. Otherwise repeat the one above.
GHL_READ_TOKEN=<YOUR_READ_TOKEN>
# Tags API key, if your CRM keeps it separate. Optional.
GHL_TAGS_API_KEY=<YOUR_TAGS_API_KEY>

# -- Token the CRM uses to call the dialer ------------------------------------
# Generated in the dialer and set in the Authorization header of the webhooks.
# It is the only thing stopping a third party from injecting fake leads.
DIALER_API_TOKEN=<TOKEN_YOU_GENERATE_IN_THE_DIALER>

# -- AI transcription (optional) ----------------------------------------------
# If left empty, nothing is transcribed and everything else keeps working.
OPENAI_API_KEY=<YOUR_API_KEY>

# -- SIP provider (optional; only to query balance and usage) -----------------
TELNYX_API_KEY=<YOUR_API_KEY>

# -- External database for reporting (optional) -------------------------------
SUPABASE_URL=<https://your-project.supabase.co>
SUPABASE_SERVICE_KEY=<YOUR_SERVICE_KEY>

# -- OMniLeads database and object storage ------------------------------------
# Scripts that run OUTSIDE Django (transcription, reporting) need direct access
# to the database and to the recordings storage.
# OMniLeads ships with factory defaults: change them in your installation and
# put yours here.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=omnileads
DB_USER=omnileads
DB_PASSWORD=<POSTGRES_PASSWORD>

STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=<STORAGE_USER>
STORAGE_SECRET_KEY=<STORAGE_PASSWORD>

# -- Time zone ----------------------------------------------------------------
# Must match the server running the phone switch. If it does not, transcription
# looks for recordings in the wrong day's folder and finds nothing.
DIALER_TZ=America/New_York

# -- Launch switch ------------------------------------------------------------
# At 0 the webhooks respond OK but do NOT inject leads. Useful to leave
# everything wired and tested before opening the tap. Set to 1 on launch day.
DIALER_LIVE=0
